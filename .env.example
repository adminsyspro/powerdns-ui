# PowerDNS Center Configuration

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Authentication Secret — signs session JWTs.
# Generate with: openssl rand -hex 32
# Rotating this logs every user out (annoying but harmless).
AUTH_SECRET=your-auth-secret-change-in-production

# Application Secret — derives the encryption key for all secrets stored in
# app_settings (LDAP bind password, OIDC client secret, PowerDNS API key, ...).
# Generate with: openssl rand -hex 32
# WARNING: rotating this makes every stored encrypted secret unreadable.
# Must be stable across upgrades. Leave unset to fall back to AUTH_SECRET on
# first start after upgrade — then set this explicitly to lock in the split.
APP_SECRET=your-app-secret-change-in-production

# PowerDNS servers are configured through the web UI at Settings → Servers
# (URL + API key are stored in the local database, not in this file).

# LDAP Authentication
LDAP_ENABLED=false
LDAP_URL=ldap://ldap.example.com:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your-ldap-password
LDAP_USER_FILTER=(uid={{username}})
LDAP_GROUP_FILTER=(memberUid={{username}})
LDAP_USERNAME_ATTR=uid
LDAP_EMAIL_ATTR=mail
LDAP_FIRSTNAME_ATTR=givenName
LDAP_LASTNAME_ATTR=sn
LDAP_GROUP_ATTR=cn
LDAP_ADMIN_GROUP=pdns-admins
LDAP_OPERATOR_GROUP=pdns-operators

# For Active Directory, use these settings:
# LDAP_URL=ldap://ad.example.com:389
# LDAP_USER_FILTER=(sAMAccountName={{username}})
# LDAP_USERNAME_ATTR=sAMAccountName
