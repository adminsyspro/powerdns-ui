# PowerDNS Center Configuration

# Application
# Public, externally-reachable base URL of this app. Used to build the OIDC
# redirect_uri and post-login redirects. REQUIRED behind a reverse proxy —
# otherwise the server only sees its internal bind address (e.g.
# http://0.0.0.0:3000) and sends that to the IdP. Set this to the URL users
# type in their browser, e.g. https://dns.example.com. Only scheme+host+port
# are used; path/trailing slash are ignored.
#
# Prefer APP_URL for deployments where one image is built once and run under a
# different URL (Docker/standalone): it is read at runtime. NEXT_PUBLIC_APP_URL
# also works at runtime here, but as a NEXT_PUBLIC_* var its value may be frozen
# at build time elsewhere — so APP_URL is the safer knob for the public URL.
# This can also be set in the UI (Settings → SSO/OIDC → Application URL), which
# takes precedence over these env vars and needs no restart.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Set to 'true' when served over HTTPS so the session cookie gets the Secure
# flag. Required in production behind an HTTPS reverse proxy.
FORCE_HTTPS=false

# Authentication Secret — signs session JWTs.
# Generate with: openssl rand -hex 32
# Rotating this logs every user out (annoying but harmless).
AUTH_SECRET=your-auth-secret-change-in-production

# Application Secret — derives the encryption key for all secrets stored in
# app_settings (LDAP bind password, OIDC client secret, PowerDNS API key, ...).
# Generate with: openssl rand -hex 32
# WARNING: rotating this makes every stored encrypted secret unreadable.
# Must be stable across upgrades. Leave unset to fall back to AUTH_SECRET on
# first start after upgrade — then set this explicitly to lock in the split.
APP_SECRET=your-app-secret-change-in-production

# PowerDNS servers are configured through the web UI at Settings → Servers
# (URL + API key are stored in the local database, not in this file).

# LDAP Authentication
LDAP_ENABLED=false
LDAP_URL=ldap://ldap.example.com:389
LDAP_BASE_DN=dc=example,dc=com
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your-ldap-password
LDAP_USER_FILTER=(uid={{username}})
LDAP_GROUP_FILTER=(memberUid={{username}})
LDAP_USERNAME_ATTR=uid
LDAP_EMAIL_ATTR=mail
LDAP_FIRSTNAME_ATTR=givenName
LDAP_LASTNAME_ATTR=sn
LDAP_GROUP_ATTR=cn
LDAP_ADMIN_GROUP=pdns-admins
LDAP_OPERATOR_GROUP=pdns-operators

# For Active Directory, use these settings:
# LDAP_URL=ldap://ad.example.com:389
# LDAP_USER_FILTER=(sAMAccountName={{username}})
# LDAP_USERNAME_ATTR=sAMAccountName

# Cloudflare integration reconcile / rate limiting
CF_MAX_RPS=3                              # max Cloudflare API requests/sec (global, per process)
CF_MAX_RETRIES=5                          # retries for 429 (any method) and 5xx/network (GET only)
INTEGRATION_RECONCILE_ENABLED=true        # set to "false" to disable the background reconcile worker
INTEGRATION_RECONCILE_INTERVAL_MS=300000  # reconcile cycle interval (5 min)
PDNS_FETCH_TIMEOUT_MS=30000               # timeout for server-side PowerDNS zone fetches (worker + sync)
